{
  "name": "renwei-roundtable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "backup": "node scripts/backup.ts",
    "start": "NODE_ENV=production node server.ts",
    "smoke:prod": "tsx scripts/smoke-production.ts",
    "verify:zhihu": "node scripts/verify-zhihu-provider.ts",
    "verify:llm": "node scripts/verify-llm-provider.ts",
    "verify:llm": "node scripts/verify-llm-provider.ts",
    "zhihu:hot": "node scripts/list-zhihu-hot.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "next typegen && node scripts/normalize-next-env.mjs && tsc --noEmit",
    "audit:repo": "node scripts/audit-repository.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
