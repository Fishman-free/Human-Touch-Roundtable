DATABASE_PATH=./data/roundtable.db
SESSION_HMAC_KEY=replace-with-at-least-32-random-bytes
PORT=3000
NEXT_PUBLIC_GAME_THEME=mountain-court
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
TOPIC_MODE=static
# Infrastructure smoke only; never enable for a public production game.
ALLOW_STATIC_TOPICS_IN_PRODUCTION=false
ZHIHU_ACCESS_SECRET=
# Optional Zhihu login. Leave credentials empty until the app is registered.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://airoundtable.stream/api/auth/zhihu/callback
# 开局会从随机候选开始，所以核验成本是「每个候选一次」而不是「每题一次」。
# 搜索额度实测只有10次/日，持久化缓存把这份成本摊到整个 TTL 周期内。
ZHIHU_TOPIC_CACHE_MS=604800000
ZHIHU_TOPIC_CACHE_PATH=./data/topic-cache.json
ZHIHU_MIN_REQUEST_INTERVAL_MS=1000
AI_MODE=mock
AI_ATTEMPT_TIMEOUT_MS=14000
AI_MAX_TOKENS=1024
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash
GLM_THINKING=disabled
METRICS_TOKEN=replace-with-a-random-monitoring-token
ADMIN_TOKEN=replace-with-at-least-32-random-bytes
