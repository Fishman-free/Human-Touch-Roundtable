DATABASE_PATH=./data/roundtable.db
SESSION_HMAC_KEY=replace-with-at-least-32-random-bytes
PORT=3000
NEXT_PUBLIC_GAME_THEME=mountain-court
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
TOPIC_MODE=static
# Infrastructure smoke only; never enable for a public production game.
ALLOW_STATIC_TOPICS_IN_PRODUCTION=false
ZHIHU_ACCESS_SECRET=
# Optional Zhihu login. Leave credentials empty until the app is registered.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://airoundtable.stream/api/auth/zhihu/callback
# 开局会从随机候选开始，成本按「候选」而不是「局」计；持久化缓存把成本摊到整个 TTL 周期内。
# 额度以 `zhihu-cli quota` 或 GET /api/v1/quota 为准（该查询本身不消耗额度）：
# 知乎搜索 5000/日、热榜 100/日，question_recommendations(creator) 与 question_answers 各 100/日，
# 未实名等低额度账号为 10/日。仓库此前记录的「搜索额度只有10次/日」与实测不符，已在文档订正。
ZHIHU_TOPIC_CACHE_MS=604800000
ZHIHU_TOPIC_CACHE_PATH=./data/topic-cache.json
ZHIHU_MIN_REQUEST_INTERVAL_MS=1000
# TOPIC_MODE=recommended 时，动态候选来自知乎问题推荐；离线启动回退到该快照文件。
ZHIHU_TOPIC_CANDIDATE_QUERY=生活方式
ZHIHU_TOPIC_CANDIDATE_COUNT=20
ZHIHU_TOPIC_CANDIDATE_PATH=./data/topic-candidates.json
ZHIHU_TOPIC_CANDIDATE_TTL_MS=604800000
ZHIHU_TOPIC_CANDIDATE_TIMEOUT_MS=3000
ZHIHU_ANSWERS_LIMIT=20
# static 表示模型不可用时使用确定性兜底文案；fail 表示宁可让该候选失败。
ZHIHU_TOPIC_FALLBACK=static
# curated-first 保持人工题下标不变；dynamic-first 仅用于演示时让动态题优先。
ZHIHU_TOPIC_UNION_ORDER=curated-first
# 题目内容生成有独立的 token 上限：AI_MAX_TOKENS 装不下完整的中文 JSON。
TOPIC_AI_MAX_TOKENS=2048
# 实测生产模型单次生成中位数约 6.5 秒、最大约 9.4 秒；给 8 秒会让约四分之一的题
# 静默回退到兜底文案，而运行仍报告成功。
TOPIC_AI_TIMEOUT_MS=18000
# 必须大于「拉回答 + 生成」的总耗时，核心默认只有 10 秒。
TOPIC_TIMEOUT_MS=20000
AI_MODE=mock
AI_ATTEMPT_TIMEOUT_MS=14000
AI_MAX_TOKENS=1024
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash
GLM_THINKING=disabled
METRICS_TOKEN=replace-with-a-random-monitoring-token
ADMIN_TOKEN=replace-with-at-least-32-random-bytes
